<script>
(()=>{
'use strict';
const $=id=>document.getElementById(id), canvas=$('pitch'),ctx=canvas.getContext('2d');
const W=960,H=600, field={x:42,y:34,w:876,h:532};
let mode='menu',playing=false,online=false,isHost=false,room='',client=null,channel=null,myId=crypto.randomUUID(),players={},localId=myId,remoteState=null;
let score=[0,0],seconds=0,last=performance.now(),lastNet=0,netErr='',xp=Number(localStorage.sfXp||0),powerCount=0,selectedSkin=localStorage.sfSkin||'classic',skinColors={classic:'#54b8ff',sunset:'#ff7557',royal:'#c78bff',legend:'#c8ff39'};
