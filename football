function config(){return {url:$('supabaseUrl').value.trim().replace(/\/$/,''),key:$('supabaseKey').value.trim()}}
async function ensureClient(){const c=config();if(!c.url||!c.key){throw new Error('Enter your Supabase project URL and publishable key in Network setup first.')}if(!window.supabase?.createClient)throw new Error('Could not load Supabase client library. Check your internet connection.');if(!client)client=window.supabase.createClient(c.url,c.key,{realtime:{params:{eventsPerSecond:20}}});return client}
function send(payload){if(!channel)return;try{channel.send({type:'broadcast',event:'game',payload:{...payload,from:myId,at:Date.now()}})}catch{}}
async function setupRoom(create){
 try{
  await leaveRoom(false);const sb=await ensureClient();room=create?Math.random().toString(36).slice(2,8).toUpperCase():$('roomCode').value.trim().toUpperCase();
  if(!room||room.length<4)throw new Error('Enter the room code your friend shared.');
  isHost=create;online=true;localId=myId;mode='online';me.name=$('playerName').value.trim().slice(0,16)||'Striker';players={};players[myId]=me;resetPositions();
  channel=sb.channel('super-football-'+room,{config:{broadcast:{self:false},presence:{key:myId}}});
  channel.on('broadcast',{event:'game'},({payload})=>{if(!payload||payload.from===myId)return;handleNet(payload)});
