const skins=[{id:'classic',name:'Classic',cost:0},{id:'sunset',name:'Sunset',cost:30},{id:'royal',name:'Royal',cost:70},{id:'legend',name:'Legend',cost:150}];
const me={id:myId,name:'Striker',x:250,y:300,vx:0,vy:0,r:18,team:0,color:skinColors.classic,boost:0,freeze:0,mega:0,goals:0,score:0};
const cpu={id:'cpu',name:'Rival Bot',x:710,y:300,vx:0,vy:0,r:18,team:1,color:'#ff5e65',boost:0,freeze:0,mega:0,goals:0,score:0};
players[myId]=me;
function toast(s){const t=$('toast');t.textContent=s;t.style.display='block';clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.style.display='none',2400)}
function sound(freq=440,dur=.09,type='sine',vol=.04){try{const a=new(window.AudioContext||window.webkitAudioContext)(),o=a.createOscillator(),g=a.createGain();o.type=type;o.frequency.value=freq;g.gain.value=vol;o.connect(g);g.connect(a.destination);o.start();g.gain.exponentialRampToValueAtTime(.001,a.currentTime+dur);o.stop(a.currentTime+dur);setTimeout(()=>a.close(),dur*1000+80)}catch{}}
function clamp(v,a,b){return Math.max(a,Math.min(b,v))}
function updateHUD(){
 $('homeName').textContent=(me.name||'HOME').toUpperCase();$('homeScore').textContent=score[0];$('awayScore').textContent=score[1];$('yourGoals').textContent=me.goals;$('powerCount').textContent=powerCount;$('coins').textContent=xp+' XP';$('clock').textContent=`${String(Math.floor(seconds/60)).padStart(2,'0')}:${String(Math.floor(seconds%60)).padStart(2,'0')} · ${playing?'LIVE':matchOver?'FULL TIME':'READY'}`;
 $('awayName').textContent=online?(Object.values(players).find(p=>p.id!==myId)?.name||'WAITING'):(mode==='cpu'?'RIVAL BOT':'AWAY');$('playerCount').textContent=`${Object.keys(players).length} / 2`;
 $('roster').innerHTML='';Object.values(players).forEach((p,i)=>{const el=document.createElement('div');el.className='player';el.innerHTML=`<div class="avatar" style="background:${p.color||skinColors.classic}">${(p.name||'?').slice(0,1).toUpperCase()}</div><div class="meta"><b>${escapeHtml(p.name||'Player')}</b><small>${p.id===myId?'YOU':p.id==='cpu'?'AI OPPONENT':'ONLINE PLAYER'}</small></div><span class="badge">${p.goals||0} G</span>`;$('roster').appendChild(el)});
 $('skins').innerHTML='';skins.forEach(s=>{const b=document.createElement('button');b.className='skin'+(selectedSkin===s.id?' selected':'');b.textContent=(s.cost&&xp<s.cost?'🔒 ':'')+s.name;b.disabled=xp<s.cost&&selectedSkin!==s.id;b.onclick=()=>{if(selectedSkin===s.id)return;if(xp<s.cost){toast('Earn more XP to unlock this kit!');return}selectedSkin=s.id;me.color=skinColors[s.id];localStorage.sfSkin=s.id;renderSkins();updateHUD();sound(700,.08);};$('skins').appendChild(b)});
}
function renderSkins(){updateHUD()}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function pitch(){
 ctx.clearRect(0,0,W,H);ctx.fillStyle='#10281a';ctx.fillRect(0,0,W,H);
 const stripe=field.w/12;for(let i=0;i<12;i++){ctx.fillStyle=i%2?'#1c6239':'#205f37';ctx.fillRect(field.x+i*stripe,field.y,stripe,field.h)}
 ctx.strokeStyle='#d9f4df';ctx.lineWidth=3;ctx.strokeRect(field.x,field.y,field.w,field.h);ctx.beginPath();ctx.moveTo(W/2,field.y);ctx.lineTo(W/2,field.y+field.h);ctx.stroke();ctx.beginPath();ctx.arc(W/2,H/2,76,0,Math.PI*2);ctx.stroke();ctx.fillStyle='#d9f4df';ctx.beginPath();ctx.arc(W/2,H/2,4,0,7);ctx.fill();
 // penalty boxes and goals
 ctx.strokeRect(field.x,190,120,220);ctx.strokeRect(field.x,245,48,110);ctx.strokeRect(field.x+field.w-120,190,120,220);ctx.strokeRect(field.x+field.w-48,245,48,110);
 ctx.fillStyle='#e7f5e8';ctx.fillRect(field.x-16,245,16,110);ctx.fillRect(field.x+field.w,245,16,110);
 // net lines
 ctx.strokeStyle='#ffffff40';ctx.lineWidth=1;for(let y=250;y<355;y+=14){ctx.beginPath();ctx.moveTo(field.x-15,y);ctx.lineTo(field.x,y);ctx.moveTo(field.x+field.w,y);ctx.lineTo(field.x+field.w+15,y);ctx.stroke()}
 // power drops
 drops.forEach(d=>{ctx.save();ctx.translate(d.x,d.y);ctx.shadowColor=d.color;ctx.shadowBlur=18;ctx.fillStyle=d.color;ctx.beginPath();ctx.arc(0,0,13,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;ctx.fillStyle='#102016';ctx.font='bold 16px Arial';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(d.type==='boost'?'⚡':d.type==='freeze'?'❄':'✦',0,1);ctx.restore()});
 // particles
 particles.forEach(p=>{ctx.globalAlpha=clamp(p.life,0,1);ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,7);ctx.fill()});ctx.globalAlpha=1;
 Object.values(players).forEach(p=>drawPlayer(p));
 if(mode==='cpu'&&playing)drawPlayer(cpu);
 // ball shadow and ball
 ctx.fillStyle='#06130a70';ctx.beginPath();ctx.ellipse(ball.x+3,ball.y+8,13,7,0,0,7);ctx.fill();ctx.fillStyle='#f7f5e9';ctx.beginPath();ctx.arc(ball.x,ball.y,ball.r,0,7);ctx.fill();ctx.strokeStyle='#26322a';ctx.lineWidth=2;ctx.stroke();ctx.fillStyle='#202b24';ctx.beginPath();ctx.arc(ball.x,ball.y,4,0,7);ctx.fill();for(let a=0;a<5;a++){let an=a*Math.PI*2/5;ctx.beginPath();ctx.arc(ball.x+Math.cos(an)*7,ball.y+Math.sin(an)*7,2.4,0,7);ctx.fill()}
}
function drawPlayer(p){if(!p)return;ctx.save();ctx.translate(p.x,p.y);ctx.fillStyle='#08130b70';ctx.beginPath();ctx.ellipse(3,12,19,9,0,0,7);ctx.fill();ctx.shadowColor=p.color;ctx.shadowBlur=p.boost>0?20:4;ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(0,0,p.r,0,7);ctx.fill();ctx.shadowBlur=0;ctx.strokeStyle='#e9f7ed';ctx.lineWidth=2;ctx.stroke();ctx.fillStyle='#102017';ctx.beginPath();ctx.arc(0,-3,8,0,7);ctx.fill();ctx.fillStyle='#fff';ctx.font='bold 10px Arial';ctx.textAlign='center';ctx.fillText((p.name||'P').slice(0,9),0,-27);if(p.boost>0){ctx.strokeStyle='#f9ff78';ctx.lineWidth=3;ctx.beginPath();ctx.arc(0,0,24,0,7);ctx.stroke()}ctx.restore()}
function spawnDrop(){if(drops.length>=3)return;const types=['boost','freeze','mega'];let type=types[Math.floor(Math.random()*types.length)];drops.push({x:field.x+70+Math.random()*(field.w-140),y:field.y+70+Math.random()*(field.h-140),type,color:type==='boost'?'#f7f76a':type==='freeze'?'#68ddff':'#e9a1ff',life:18})}
function burst(x,y,color){for(let i=0;i<22;i++)particles.push({x,y,vx:(Math.random()-.5)*220,vy:(Math.random()-.5)*220,life:.4+Math.random()*.55,r:2+Math.random()*4,color})}
function resetPositions(){me.x=250;me.y=H/2;me.vx=me.vy=0;cpu.x=710;cpu.y=H/2;cpu.vx=cpu.vy=0;for(const p of Object.values(players)){if(p.id!==myId){p.x=710;p.y=H/2;p.vx=p.vy=0}}ball.x=W/2;ball.y=H/2;ball.vx=ball.vy=0;ball.owner=null}
function goal(team){score[team]++;if(team===0){me.goals++;xp+=10;localStorage.sfXp=xp;toast('GOAL! +10 XP');}else toast('The rival scored!');sound(team===0?880:220,.35,'triangle',.07);burst(ball.x,ball.y,team===0?'#c8ff39':'#ff5e65');resetPositions();updateHUD();if(online)send({type:'goal',score,players:serializePlayers()})}
function serializePlayers(){return Object.values(players).map(p=>({id:p.id,name:p.name,x:p.x,y:p.y,vx:p.vx,vy:p.vy,r:p.r,team:p.team,color:p.color,boost:p.boost,freeze:p.freeze,mega:p.mega,goals:p.goals||0}))}
function begin(which){mode=which;playing=true;matchOver=false;seconds=0;score=[0,0];me.goals=0;cpu.goals=0;players={};players[myId]=me;me.name=$('playerName').value.trim().slice(0,16)||'Striker';me.color=skinColors[selectedSkin]||skinColors.classic;resetPositions();drops=[];spawnDrop();$('overlay').classList.add('hidden');updateHUD();toast(which==='cpu'?'Kick-off! Beat the rival bot.':'Room ready. Waiting for opponent…');sound(500,.15);if(online)send({type:'start',players:serializePlayers(),score});}
function showMenu(title='Kick off?',msg='Play a quick match against the AI, or create a room and challenge a friend online with a room code.'){ $('modalTitle').textContent=title;$('modalText').textContent=msg;$('overlay').classList.remove('hidden')}
